# Copy to .env and fill in. Never commit .env.

# Public domain name that points at this server. Caddy gets a certificate for it.
FERRET_DOMAIN=ferret.example.com

# SMTP server that sends the sign-in links.
FERRET_SMTP_HOST=smtp.example.com
# SMTP port (587 for starttls, 465 for ssl).
FERRET_SMTP_PORT=587
# SMTP login, if the server needs one.
FERRET_SMTP_USERNAME=ferret@example.com
FERRET_SMTP_PASSWORD=change-me
# Address the sign-in links come from.
FERRET_SMTP_FROM=ferret@example.com
# starttls, ssl or none.
FERRET_SMTP_SECURITY=starttls

# Google OAuth client for "Continue with Google". Leave empty to turn it off.
FERRET_GOOGLE_CLIENT_ID=
FERRET_GOOGLE_CLIENT_SECRET=
